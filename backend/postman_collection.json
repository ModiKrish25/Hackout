			"name": "1. Auth - Register Generator",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"try {",
							"    var res = pm.response.json();",
							"    var d = res.data ? res.data : res;",
							"    if (d && d.user && d.user.id) {",
							"        pm.collectionVariables.set(\"generatorId\", d.user.id);",
							"    }",
							"    if (d && (d.token || d.accessToken)) {",
							"        pm.collectionVariables.set(\"generatorToken\", d.token || d.accessToken);",
							"    }",
							"} catch(e) {}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Demo Organic Agro Farm\",\n    \"email\": \"generator.demo.{{$timestamp}}@example.com\",\n    \"password\": \"Password123!\",\n    \"role\": \"generator\",\n    \"locationLat\": 13.0645,\n    \"locationLng\": 77.5852\n}"
